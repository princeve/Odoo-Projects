<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="website_sales_intelligence_view_website_sales_ai_client_list" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.ai.client.list</field>
        <field name="model">website.sales.ai.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" optional="hide"/>
                <field name="name"/>
                <field name="is_enabled"/>
                <field name="state"/>
                <field name="provider"/>
                <field name="model_name" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="website_id" optional="hide"/>
                <field name="last_tested_at" optional="hide"/>
                <field name="last_test_status" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="website_sales_intelligence_view_website_sales_ai_client_form" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.ai.client.form</field>
        <field name="model">website.sales.ai.client</field>
        <field name="arch" type="xml">
            <form string="Website Sales AI Client">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Scope">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="is_enabled"/>
                            <field name="state" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="website_id"/>
                        </group>

                        <group string="Provider">
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="endpoint_url"/>
                            <field name="verify_ssl"/>
                            <field name="timeout_seconds"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Authentication">
                            <group>
                                <group>
                                    <field name="api_key_name"/>
                                    <field name="api_key_prefix"/>
                                </group>
                                <group>
                                    <field name="api_key" password="1"/>
                                </group>
                            </group>

                            <group string="Extra Headers">
                                <field name="extra_headers_json"
                                       placeholder='{"api-version": "2024-10-01"}'/>
                            </group>
                        </page>

                        <page string="Parameters">
                            <group>
                                <group>
                                    <field name="temperature"/>
                                    <field name="max_tokens"/>
                                </group>
                                <group>
                                    <field name="top_p"/>
                                    <field name="frequency_penalty"/>
                                    <field name="presence_penalty"/>
                                </group>
                            </group>
                        </page>

                        <page string="Prompts">
                            <group>
                                <field name="system_prompt"/>
                                <field name="user_prompt_template"
                                       placeholder="Use {payload} placeholder"/>
                            </group>
                        </page>

                        <page string="Logging">
                            <group>
                                <field name="enable_debug_logging"/>
                                <field name="note"/>
                            </group>
                        </page>

                        <page string="Last Test">
                            <group>
                                <group>
                                    <field name="last_tested_at" readonly="1"/>
                                    <field name="last_test_status" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_test_message" readonly="1"/>
                                </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="website_sales_intelligence_action_website_sales_ai_clients" model="ir.actions.act_window">
        <field name="name">AI Clients</field>
        <field name="res_model">website.sales.ai.client</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
