<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="website_sales_intelligence_view_website_sales_visitor_list" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.visitor.list</field>
        <field name="model">website.sales.visitor</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="website_id"/>
                <field name="last_seen"/>
                <field name="device_type"/>
                <field name="consent_state"/>
                <field name="intent_score"/>
                <field name="intent_level"/>
                <field name="funnel_stage"/>
                <field name="ai_conversion_probability"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="website_sales_intelligence_view_website_sales_visitor_form" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.visitor.form</field>
        <field name="model">website.sales.visitor</field>
        <field name="arch" type="xml">
            <form string="Website Sales Visitor">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identity">
                            <field name="visitor_uuid" readonly="1"/>
                            <field name="website_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="active"/>
                        </group>

                        <group string="Activity">
                            <field name="first_seen" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="session_count" readonly="1"/>
                            <field name="event_count" readonly="1"/>
                            <field name="last_event_type" readonly="1"/>
                            <field name="last_url" readonly="1"/>
                            <field name="last_referrer" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Intent  Funnel">
                            <group>
                                <group>
                                    <field name="intent_score"/>
                                    <field name="intent_level" readonly="1"/>
                                    <field name="funnel_stage"/>
                                </group>
                                <group>
                                    <field name="engagement_score"/>
                                    <field name="urgency_score"/>
                                    <field name="price_sensitivity_score"/>
                                </group>
                            </group>

                            <group string="Commerce Signals">
                                <group>
                                    <field name="cart_items_count"/>
                                    <field name="cart_value"/>
                                    <field name="currency_id"/>
                                </group>
                                <group>
                                    <field name="checkout_started"/>
                                    <field name="checkout_abandoned"/>
                                    <field name="rfq_submitted"/>
                                    <field name="contact_submitted"/>
                                </group>
                            </group>
                        </page>

                        <page string="Interest">
                            <group>
                                <field name="interest_product_ids" widget="many2many_tags"/>
                                <!-- <field name="interest_category_ids" widget="many2many_tags"/> -->
                                <field name="search_keywords"/>
                            </group>
                        </page>

                        <page string="Marketing">
                            <group>
                                <group string="UTM">
                                    <field name="utm_source"/>
                                    <field name="utm_medium"/>
                                    <field name="utm_campaign"/>
                                    <field name="utm_term"/>
                                    <field name="utm_content"/>
                                </group>
                                <group string="Click IDs">
                                    <field name="gclid"/>
                                    <field name="fbclid"/>
                                </group>
                            </group>
                        </page>

                        <page string="AI">
                            <group>
                                <group>
                                    <field name="ai_conversion_probability"/>
                                    <field name="ai_next_best_action"/>
                                    <field name="ai_model_version"/>
                                    <field name="ai_last_scored_at"/>
                                </group>
                                <group>
                                    <field name="ai_summary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Privacy  Device">
                            <group>
                                <group>
                                    <field name="consent_state"/>
                                    <field name="consent_ts"/>
                                    <field name="privacy_note"/>
                                </group>
                                <group>
                                    <field name="device_type"/>
                                    <field name="timezone"/>
                                    <field name="country_id"/>
                                    <field name="region"/>
                                    <field name="city"/>
                                    <field name="latitude" readonly="1"/>
                                    <field name="longitude" readonly="1"/>
                                    <field name="geo_accuracy" readonly="1"/>
                                        <field name="map_url" widget="url" string="Open Map" readonly="1"/>
                                </group>
                            </group>

                            <group string="Hashed Identifiers">
                                <field name="ip_hash" readonly="1"/>
                                <field name="user_agent_hash" readonly="1"/>
                                <field name="user_agent"/>
                            </group>
                        </page>

                        <page string="Automation  Debug">
                            <group>
                                <group>
                                    <field name="last_action_at" readonly="1"/>
                                    <field name="last_action_type" readonly="1"/>
                                    <field name="action_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="merged_into_id"/>
                                    <field name="is_merged" readonly="1"/>
                                </group>
                            </group>

                            <group>
                                <field name="debug_payload_sample"/>
                                <field name="note"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="website_sales_intelligence_action_website_sales_visitors" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="res_model">website.sales.visitor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
