<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="website_sales_intelligence_view_website_sales_rule_list" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.rule.list</field>
        <field name="model">website.sales.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" optional="hide"/>
                <field name="name"/>
                <field name="is_enabled"/>
                <field name="state"/>
                <field name="trigger_type"/>
                <field name="trigger_event_type" optional="hide"/>
                <field name="action_strategy"/>
                <field name="dry_run" optional="show"/>
                <field name="use_ai" optional="hide"/>
                <field name="last_triggered_at" optional="hide"/>
                <field name="hit_count" optional="hide"/>
                <field name="success_count" optional="hide"/>
                <field name="fail_count" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="website_sales_intelligence_view_website_sales_rule_form" model="ir.ui.view">
        <field name="name">website_sales_intelligence.website.sales.rule.form</field>
        <field name="model">website.sales.rule</field>
        <field name="arch" type="xml">
            <form string="Website Sales Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Overview">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="is_enabled"/>
                            <field name="state"/>
                            <field name="version"/>
                        </group>

                        <group string="Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="website_id"/>
                            <field name="create_action_log"/>
                            <field name="log_level"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Trigger">
                            <group>
                                <group>
                                    <field name="trigger_type"/>
                                    <field name="trigger_event_category"/>
                                    <field name="trigger_event_type"/>
                                    <field name="trigger_event_name"/>
                                </group>
                                <group>
                                    <field name="schedule_interval_number"/>
                                    <field name="schedule_interval_type"/>
                                    <field name="schedule_next_run"/>
                                    <field name="schedule_last_run"/>
                                </group>
                            </group>
                        </page>

                        <page string="Conditions">
                            <group>
                                <field name="condition_operator"/>
                                <field name="conditions_json"
                                       placeholder='[{"field":"intent_score","op":">=","value":70}]'/>
                                <field name="domain_filter" placeholder="[('field','=','value')]"/>
                            </group>

                            <group string="Common Thresholds">
                                <group>
                                    <field name="min_intent_score"/>
                                    <field name="min_engagement_score"/>
                                    <field name="min_session_count"/>
                                    <field name="min_event_count"/>
                                </group>
                                <group>
                                    <field name="min_cart_value"/>
                                    <field name="require_checkout_abandoned"/>
                                    <field name="require_authenticated"/>
                                    <field name="require_contact_available"/>
                                </group>
                            </group>

                            <group string="Allow / Block">
                                <group>
                                    <field name="allowed_country_ids" widget="many2many_tags"/>
                                    <field name="blocked_country_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="allowed_device_type"/>
                                </group>
                            </group>
                        </page>

                        <page string="Actions">
                            <group>
                                <group>
                                    <field name="action_strategy"/>
                                    <field name="action_title"/>
                                    <field name="action_payload_json"
                                           placeholder='{"team_id": 3, "activity_type_id": 2}'/>
                                </group>
                                <group>
                                    <field name="crm_team_id"/>
                                    <field name="assign_user_id"/>
                                    <field name="activity_type_id"/>
                                    <field name="mail_template_id"/>
                                </group>
                            </group>

                            <group string="Activity Details">
                                <field name="activity_summary"/>
                                <field name="activity_note"/>
                            </group>

                            <group string="Webhook">
                                <field name="webhook_url"/>
                                <field name="webhook_method"/>
                            </group>
                        </page>

                        <page string="AI">
                            <group>
                                <group>
                                    <field name="use_ai"/>
                                    <field name="ai_client_id"/>
                                    <field name="ai_prediction_type"/>
                                </group>
                                <group>
                                    <field name="dry_run"/>
                                </group>
                            </group>
                        </page>

                        <page string="Safety">
                            <group>
                                <group>
                                    <field name="max_actions_per_visitor_per_day"/>
                                    <field name="cooldown_minutes"/>
                                </group>
                                <group>
                                    <field name="dry_run"/>
                                </group>
                            </group>
                        </page>

                        <page string="Stats">
                            <group>
                                <group>
                                    <field name="last_triggered_at" readonly="1"/>
                                    <field name="last_trigger_state" readonly="1"/>
                                </group>
                                <group>
                                    <field name="hit_count" readonly="1"/>
                                    <field name="success_count" readonly="1"/>
                                    <field name="fail_count" readonly="1"/>
                                </group>
                            </group>

                            <group>
                                <field name="last_trigger_message" readonly="1"/>
                            </group>
                        </page>

                        <page string="Notes">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="website_sales_intelligence_action_website_sales_rules" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="res_model">website.sales.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>