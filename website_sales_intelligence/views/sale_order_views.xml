<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_sales_intelligence_view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">website_sales_intelligence.sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Website Sales Intelligence" name="website_sales_intelligence_sale_order_page">

                    <group>
                        <group string="Links">
                            <field name="website_sales_visitor_id"/>
                            <field name="website_sales_session_id"/>
                            <field name="website_sales_attribution_id"/>
                        </group>

                        <group string="Conversion Snapshot">
                            <field name="website_sales_intent_level"/>
                            <field name="website_sales_funnel_stage"/>
                            <field name="website_sales_intent_score"/>
                            <field name="website_sales_engagement_score"/>
                            <field name="website_sales_ai_conversion_probability"/>
                        </group>
                    </group>

                    <group string="Marketing Snapshot">
                        <group>
                            <field name="website_sales_marketing_channel"/>
                            <field name="website_sales_utm_source"/>
                            <field name="website_sales_utm_medium"/>
                            <field name="website_sales_utm_campaign"/>
                        </group>
                        <group>
                            <field name="website_sales_utm_term"/>
                            <field name="website_sales_utm_content"/>
                            <field name="website_sales_gclid"/>
                            <field name="website_sales_fbclid"/>
                            <field name="website_sales_msclkid"/>
                        </group>
                    </group>

                    <group string="Device &amp; Geo Snapshot">
                        <group>
                            <field name="website_sales_device_type"/>
                            <field name="website_sales_ip_address"/>
                            <field name="website_sales_country_id"/>
                        </group>
                        <group>
                            <field name="website_sales_region"/>
                            <field name="website_sales_city"/>
                            <field name="website_sales_timezone"/>
                        </group>
                    </group>

                    <group string="AI Summary">
                        <field name="website_sales_ai_next_best_action"/>
                        <field name="website_sales_ai_summary"/>
                    </group>

                    <group string="Technical">
                        <group>
                            <field name="website_sales_correlation_id"/>
                            <field name="website_sales_trace_id"/>
                        </group>
                        <group>
                            <field name="website_sales_payload_json"/>
                            <field name="website_sales_note"/>
                        </group>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>