<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_sales_intelligence_view_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">website_sales_intelligence.res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Website Sales Intelligence" name="website_sales_intelligence_partner_page">
                    <group>
                        <group string="Identity Links">
                            <field name="website_sales_primary_visitor_id"/>
                            <field name="website_sales_last_session_id"/>
                            <field name="website_sales_last_event_id"/>
                        </group>

                        <group string="Freshness">
                            <field name="website_sales_first_seen_datetime"/>
                            <field name="website_sales_last_seen_datetime"/>
                        </group>
                    </group>

                    <group string="Activity Metrics">
                        <group>
                            <field name="website_sales_lifetime_session_count"/>
                            <field name="website_sales_lifetime_event_count"/>
                            <field name="website_sales_lifetime_page_view_count"/>
                            <field name="website_sales_lifetime_product_view_count"/>
                        </group>
                        <group>
                            <field name="website_sales_lifetime_add_to_cart_count"/>
                            <field name="website_sales_lifetime_checkout_start_count"/>
                            <field name="website_sales_lifetime_checkout_submit_count"/>
                            <field name="website_sales_is_checkout_abandoned"/>
                        </group>
                    </group>

                    <group string="Commerce">
                        <group>
                            <field name="website_sales_last_cart_item_count"/>
                            <field name="website_sales_last_cart_value"/>
                        </group>
                        <group>
                            <field name="website_sales_lifetime_order_count"/>
                            <field name="website_sales_lifetime_revenue"/>
                        </group>
                    </group>

                    <group string="Marketing">
                        <group>
                            <field name="website_sales_primary_marketing_channel"/>
                            <field name="website_sales_primary_utm_source"/>
                            <field name="website_sales_primary_utm_medium"/>
                            <field name="website_sales_primary_utm_campaign"/>
                        </group>
                        <group string="Device &amp; Location">
                            <field name="website_sales_primary_device_type"/>
                            <field name="website_sales_country_id"/>
                            <field name="website_sales_region"/>
                            <field name="website_sales_city"/>
                            <field name="website_sales_timezone"/>
                        </group>
                    </group>

                    <group string="Scoring">
                        <group>
                            <field name="website_sales_intent_level"/>
                            <field name="website_sales_funnel_stage"/>
                            <field name="website_sales_intent_score"/>
                            <field name="website_sales_engagement_score"/>
                        </group>
                        <group>
                            <field name="website_sales_ai_conversion_probability"/>
                            <field name="website_sales_ai_next_best_action"/>
                        </group>
                    </group>

                    <group string="AI Summary">
                        <field name="website_sales_ai_summary"/>
                    </group>

                    <group string="Notes">
                        <field name="website_sales_note"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>


